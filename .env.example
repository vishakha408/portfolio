# Get a free key at https://aistudio.google.com/apikey
# Copy this file to .env and paste your real key there. Never commit .env.
GEMINI_API_KEY=your_gemini_api_key_here

# Model used to generate the final answer.
# gemini-2.5-flash is stable and cheap. Swap for gemini-3.5-flash (or newer)
# once you've confirmed your account has access to the 3.x family.
GEMINI_MODEL=gemini-2.5-flash

# Model used to embed chunks and queries into vectors.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# CORS: the origin your React dev server runs on.
FRONTEND_ORIGIN=http://localhost:5173

# How many chunks the retriever pulls per question.
RAG_TOP_K=4
